  m_Script: {fileID: 11500000, guid: edb57f15223fa564eb53e3e73f448a11, type: 3}
  m_Name: EntrandoNoJogo
  m_EditorClassIdentifier: 
  title: Entrando em uma Partida
  body: "1. Acesse a <b>Partida Personalizada</b> a partir do <b>Menu Inicial</b>.\n\n2.
    Obrigatoriamente preencha os campos de <b>Nome</b> e <b>Turma</b> (se n\xE3o
    fizer parte de uma turma criada, crie um nome novo)\n\n3. Selecione uma <b>Dificuldade</b>,
    <b>Mapa</b>, e <b>Inicie a Partida</b>."
