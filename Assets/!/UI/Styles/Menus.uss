}

Slider #unity-dragger {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/!/UI/Assets/toggle.png?fileID=21300000&guid=fc7944894c937444b81f0c53b2911ffe&type=3#toggle");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    scale: 1.8 1.5;
}

Slider #unity-tracker {
    scale: 1 0.5;
}
