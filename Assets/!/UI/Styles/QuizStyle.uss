:root {
}

.selectedAnswers {
    flex-direction: row-reverse;
    font-size: 20px;
    -unity-text-align: middle-left;
    justify-content: center;
    align-self: auto;
    align-content: auto;
    align-items: center;
    margin-right: 0;
    margin-left: 0;
    background-image: url("project://database/Assets/!/UI/Assets/Selected_Option.png?fileID=21300000&guid=c0b3938d71164164cb7d27fdd5cad306&type=3#Selected_Option");
    margin-top: 0;
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/!/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&guid=6a4bdc0fad33a1040a0b506eb3b3ffd8&type=3#Barlow-Regular");
    padding-bottom: 1%;
    padding-top: 1%;
    flex-grow: 1;
    padding-left: 3%;
    -unity-font-style: bold;
}

.unity-toggle__checkmark {
    display: none;
}

.unity-radio-button__checkmark-background {
    display: none;
}

Toggle Label {
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-left;
}

#VisualElement > #Quiz > #AnswersContainer > .answers > .unity-radio-button__label {
    white-space: normal;
    -unity-text-align: middle-left;
}
