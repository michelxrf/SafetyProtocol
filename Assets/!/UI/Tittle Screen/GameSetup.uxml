<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/!/UI/Styles/Leaderboard.uss?fileID=7433441132597879392&amp;guid=cb9193efaf9345e47847c38266f3b8f2&amp;type=3#Leaderboard" />
    <Style src="project://database/Assets/!/UI/Styles/Menus.uss?fileID=7433441132597879392&amp;guid=733d1cbb52089e94ba0a1b470523af93&amp;type=3#Menus" />
    <ui:VisualElement style="flex-grow: 1; flex-direction: row; font-size: 24px; justify-content: space-between; background-image: url(&quot;project://database/Assets/!/UI/Assets/Background2.png?fileID=2800000&amp;guid=a33c67b5e0593384598298aa970ac800&amp;type=3#Background2&quot;);">
        <ui:VisualElement name="ActionButtons" enabled="true" style="position: absolute; top: 89%; left: auto; justify-content: center; width: 100%; flex-direction: row;">
            <ui:Button text="Voltar" name="Back" class="g-button" style="width: 360px; height: 84px;" />
            <ui:Button text="Iniciar Partida" name="Play" class="y-button" style="width: 360px; height: 84px;" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; justify-content: space-around; left: 5%; right: auto; flex-shrink: 0; position: absolute; bottom: auto; top: 16%; background-image: url(&quot;project://database/Assets/!/UI/Assets/MenuPanel.png?fileID=2800000&amp;guid=39e2698ca8449aa4d8f3720c01bfc962&amp;type=3#MenuPanel&quot;); width: 44%; height: 68%; padding-right: 1%; padding-left: 1%; padding-top: 2%; padding-bottom: 2%;">
            <ui:Label text="CONFIGURAÇÕES DA PARTIDA" name="Label" class="font-barlow-bold" style="-unity-text-align: upper-center; margin-top: 27px; margin-bottom: 21px; font-size: 28px;" />
            <ui:VisualElement name="InputFields" class="font-barlow-regular" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/!/UI/Assets/inner_box.png?fileID=21300000&amp;guid=0588f3df2cdf3944a989a206b7ef7809&amp;type=3#inner_box&quot;); flex-direction: column; margin-bottom: 2%; background-color: rgba(0, 0, 0, 0); -unity-slice-type: sliced;">
                <ui:TextField label="Aluno" placeholder-text="digite o seu nome..." name="UserName" max-length="21" />
                <ui:TextField label="Turma" placeholder-text="digite o nome da turma..." name="LeaderboardName" hide-placeholder-on-focus="true" />
            </ui:VisualElement>
            <ui:VisualElement name="LevelSetup" class="font-regular" style="flex-grow: 1; background-image: none; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0;">
                <ui:RadioButtonGroup label="Dificuldade" choices="Fácil,Normal,Difícil" value="0" name="Difficulty" style="background-image: url(&quot;project://database/Assets/!/UI/Assets/inner_box.png?fileID=21300000&amp;guid=0588f3df2cdf3944a989a206b7ef7809&amp;type=3#inner_box&quot;);" />
                <ui:RadioButtonGroup label="Mapa" choices="Level_1" value="0" name="Map" style="background-image: url(&quot;project://database/Assets/!/UI/Assets/inner_box.png?fileID=21300000&amp;guid=0588f3df2cdf3944a989a206b7ef7809&amp;type=3#inner_box&quot;); margin-top: 12px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="font-regular" style="left: 51%; right: auto; position: absolute; top: 16%; background-image: url(&quot;project://database/Assets/!/UI/Assets/MenuPanel.png?fileID=2800000&amp;guid=39e2698ca8449aa4d8f3720c01bfc962&amp;type=3#MenuPanel&quot;); height: 68%; width: 44%; padding-top: 2%; padding-right: 1%; padding-bottom: 2%; padding-left: 1%;">
            <ui:Label text="PLACAR DA TURMA" name="Title" class="font-barlow-bold" style="-unity-text-align: upper-center; font-size: 28px; flex-grow: 0; border-top-width: 10px; border-bottom-width: 10px; margin-top: 27px; margin-bottom: 21px;" />
            <ui:VisualElement name="Leaderboard" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/!/UI/Assets/inner_box.png?fileID=21300000&amp;guid=0588f3df2cdf3944a989a206b7ef7809&amp;type=3#inner_box&quot;);">
                <ui:VisualElement name="Header" class="ScoreEntry" style="flex-direction: row; border-bottom-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; align-self: stretch;">
                    <ui:Label text="#" name="Rank" class="RankColumm" style="width: 10%; flex-grow: 0; -unity-text-align: upper-center;" />
                    <ui:Label text="Jogador" name="Name" class="NameColumm" />
                    <ui:Label text="Pontuação" name="Score" class="ScoreColumm" />
                </ui:VisualElement>
                <ui:Label text="Digite o código da turma para ver o placar." name="Notice" style="-unity-text-align: middle-center; font-size: 48px; flex-grow: 1; border-top-width: 10px; border-bottom-width: 10px; white-space: pre-wrap;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
