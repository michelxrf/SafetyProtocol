<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/!/UI/Styles/Menus.uss?fileID=7433441132597879392&amp;guid=733d1cbb52089e94ba0a1b470523af93&amp;type=3#Menus" />
    <ui:VisualElement style="background-image: url(&quot;project://database/Assets/!/UI/Assets/Background2.png?fileID=2800000&amp;guid=a33c67b5e0593384598298aa970ac800&amp;type=3#Background2&quot;); flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/!/UI/Assets/MenuPanel.png?fileID=21300000&amp;guid=39e2698ca8449aa4d8f3720c01bfc962&amp;type=3#MenuPanel&quot;); width: 44%; height: 68%; position: absolute; top: 16%; left: auto; align-self: center;">
            <ui:Label text="COMO JOGAR" name="Label" style="font-size: 28px; -unity-font-definition: url(&quot;project://database/Assets/!/Fonts/Barlow/Barlow-Bold.ttf?fileID=12800000&amp;guid=b6fda5bf6e56b194da1cfd4a2a2dde5c&amp;type=3#Barlow-Bold&quot;); -unity-text-align: middle-center; margin-top: 4%; margin-right: 4%; margin-bottom: 4%; margin-left: 4%;" />
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/!/UI/Assets/inner_box.png?fileID=21300000&amp;guid=0588f3df2cdf3944a989a206b7ef7809&amp;type=3#inner_box&quot;); margin-right: 2%; margin-left: 2%; margin-top: 2%; margin-bottom: 2%; align-items: stretch; -unity-font-definition: url(&quot;project://database/Assets/!/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&amp;guid=6a4bdc0fad33a1040a0b506eb3b3ffd8&amp;type=3#Barlow-Regular&quot;); color: rgb(87, 104, 73); white-space: pre-wrap; padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%;">
                <ui:Label text="Label" name="Title" style="-unity-text-align: middle-left; -unity-font-definition: url(&quot;project://database/Assets/!/Fonts/Barlow/Barlow-Bold.ttf?fileID=12800000&amp;guid=b6fda5bf6e56b194da1cfd4a2a2dde5c&amp;type=3#Barlow-Bold&quot;); -unity-font-style: bold; font-size: 36px; white-space: normal;" />
                <ui:Label text="ervisione o mapa, atento aos riscos que podem existir no cenário e vigiando para que nenhum acidente aconteça.&#10;&#10;Eventualmente algum trabalhador poderá sofrer um acidente. Você será notificado com uma mensagem de alerta, com o tempo restante para você identificar qual trabalhador está ameaçado e evitar que o pior aconteça.&#10;&#10;Ao clicar no trabalhador ameaçado, surgirá uma janela com uma pergunta sobre as condições em que  " name="Body" style="flex-grow: 1; font-size: 28px; -unity-text-align: upper-left; white-space: normal; text-overflow: clip;" />
                <ui:Label text="0/0" name="Index" style="-unity-text-align: middle-center; font-size: 28px; border-left-color: rgb(87, 104, 73); border-right-color: rgb(87, 104, 73); border-top-color: rgb(87, 104, 73); border-bottom-color: rgb(87, 104, 73); border-top-width: 1px; margin-top: 0%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" style="flex-grow: 0; flex-direction: row; justify-content: center; top: 89%; bottom: auto;">
