        <ui:VisualElement name="AlertIcon" picking-mode="Ignore" style="background-image: url(&quot;project://database/Assets/!/UI/Assets/AlertPanel.png?fileID=2800000&amp;guid=f3cb9601a1e5fcf4ba0e3b7a3fd99adf&amp;type=3#AlertPanel&quot;); -unity-background-scale-mode: scale-to-fit; background-position-x: center 0; width: 680px; height: 110px; align-items: center; align-self: center; align-content: center; position: absolute; left: auto; top: 29px;">
            <ui:Label text="Alguém está em risco" class="font-barlow-bold" style="color: rgb(109, 0, 0); -unity-text-outline-color: rgb(255, 200, 200); -unity-text-outline-width: 1.5px; font-size: 25.33px;" />
