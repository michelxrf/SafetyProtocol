<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; width: 90%; justify-content: space-around; align-items: stretch; align-content: center; margin-left: 5%;">
        <ui:Button text="PAUSE" name="PauseButton" style="width: 20%; padding-left: 12px; height: 10%; margin-left: 5%;" />
        <ui:VisualElement name="Accidents" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="Accidents:" name="Label" picking-mode="Ignore" style="font-size: 28px;" />
            <ui:Label text="X" name="SolvedAccidents" picking-mode="Ignore" style="font-size: 28px;" />
            <ui:Label text="/" picking-mode="Ignore" style="font-size: 28px;" />
            <ui:Label text="X" name="MaxAccidents" style="font-size: 28px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Hazards" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="Hazzards:" name="Label" picking-mode="Ignore" style="font-size: 28px;" />
            <ui:Label text="X" name="SolvedHazards" picking-mode="Ignore" style="font-size: 28px;" />
            <ui:Label text="/" picking-mode="Ignore" style="font-size: 28px;" />
            <ui:Label text="X" name="MaxHazards" picking-mode="Ignore" style="font-size: 28px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
